# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Base URL of your Firefly III instance, no trailing slash
FIREFLY_URL=https://firefly.example.com
# Optional: URL used for links in messages if FIREFLY_URL is internal
#FIREFLY_PUBLIC_URL=
# Personal access token (Firefly III > Options > Profile > OAuth)
FIREFLY_TOKEN=
# Comma separated Telegram user IDs allowed to use the bot
ALLOWED_USER_IDS=
TZ=Europe/Moscow
# Name or numeric id of the default asset account
DEFAULT_SOURCE_ACCOUNT=
# Inside the container; mounted from ./data by docker-compose
DATA_DIR=/data
# debug | info | warn | error
LOG_LEVEL=info
# How often account/category caches are refreshed
#CACHE_REFRESH_HOURS=6

# Webhook mode (leave WEBHOOK_URL empty for long polling)
#WEBHOOK_URL=https://bot.example.com
#WEBHOOK_SECRET=
#WEBHOOK_LISTEN=:8080
#WEBHOOK_PATH=/telegram/webhook
